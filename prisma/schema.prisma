// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  DIREKTUR
  GURU
}

enum Jenis_Kelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum Kategori {
  TAHSIN
  TAHFIDZ
}

enum Predikat {
  MUMTAZ
  JAYYID_JIDDAN
  JAYYID
  MAQBUL
  DHAIF
}

enum Tahapan {
  JILID_1
  JILID_2
  JILID_3
  JILID_4
  JILID_5
  JILID_6
  TILAWAH_JUZ_1_5
  GHARIB
  TAJWID
  MUNAQOSYAH
  ALQURAN // Deprecated: sudah tidak dipakai di aplikasi, tetapi harus tetap ada di schema karena PostgreSQL tidak bisa DROP enum value yang sudah terdaftar di tipe enum.
}

enum STATUS_KELULUSAN {
  LULUS
  TIDAK_LULUS
}

enum STATUS_KELANJUTAN {
  LANJUT
  MENGULANG
}

enum STATUS_PENGAJUAN {
  MENUNGGU
  DISELESAIKAN
  DITOLAK
}

model Surah {
  no_surah             Int                @id
  nama_surah           String
  jumlah_ayat          Int
  setoranHafalans      Setoran_Hafalan[]
  setoranMurajaahs     Setoran_Murajaah[]
  setoranTahsins       Setoran_Tahsin[]   @relation("HafalanSurah")
  setoranHafalanTahsin Setoran_Tahsin[]   @relation("LaporanBacaan")
  ujianPretests        Ujian_Pretest[]

  @@map("surah")
}

model User {
  id            String  @id @default(uuid())
  nama          String
  email         String  @unique
  no_telp       String
  password      String
  role          Role    @default(GURU)
  profile_photo String?

  jenis_kelamin  Jenis_Kelamin @default(LAKI_LAKI)
  is_sertifikasi Boolean       @default(false)

  halaqoh        Halaqoh[]
  updatedAt      DateTime          @default(now())
  createdAt      DateTime          @default(now())
  // token dipindah ke model Session (multi-device support)
  pengajuanUjian Pengajuan_Ujian[]
  sessions       Session[]

  @@map("users")
}

model Siswa {
  nis           String        @id
  nama          String
  jenis_kelamin Jenis_Kelamin @default(LAKI_LAKI)
  tanggal_lahir DateTime      @db.Date
  alamat        String
  nama_wali     String
  no_telp       String
  profile_photo String?
  // token dipindah ke model Session (multi-device support)
  updatedAt     DateTime      @default(now())
  createdAt     DateTime      @default(now())

  halaqoh_tahsin_id  String?
  halaqoh_tahfidz_id String?

  halaqoh_tahsin  Halaqoh? @relation("SiswaTahsin", fields: [halaqoh_tahsin_id], references: [id])
  halaqoh_tahfidz Halaqoh? @relation("SiswaTahfidz", fields: [halaqoh_tahfidz_id], references: [id])

  tahapan_tahsin Tahapan?

  setoranHafalan Setoran_Hafalan[]  @relation("LaporanHafalanBaru")
  setoranTahsin  Setoran_Tahsin[]   @relation("LaporanTahsinBaru")
  murajaah       Setoran_Murajaah[]
  ujianKenaikan  Ujian_Kenaikan[]
  ujianPretest   Ujian_Pretest[]

  riwayatKelas   Riwayat_Kelas[]
  pengajuanUjian Pengajuan_Ujian[]
  sessions       Session[]

  @@index([halaqoh_tahsin_id])
  @@index([halaqoh_tahfidz_id])
  @@index([tahapan_tahsin])
  @@index([nama])
  @@map("siswa")
}

model Tahun_Akademik {
  id           String          @id @default(uuid())
  nama_tahun   String
  is_active    Boolean         @default(false)
  riwayatKelas Riwayat_Kelas[]

  @@map("tahun_akademik")
}

model Riwayat_Kelas {
  id String @id @default(uuid())

  nis_siswa String

  tahun_id   String
  nama_kelas String
  status     String

  siswa          Siswa          @relation(fields: [nis_siswa], references: [nis], onDelete: Cascade)
  tahun_akademik Tahun_Akademik @relation(fields: [tahun_id], references: [id])

  @@index([nis_siswa])
  @@index([status])
  @@map("riwayat_kelas")
}

model Halaqoh {
  id       String   @id @default(uuid())
  nama     String
  kategori Kategori @default(TAHSIN)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  siswaTahsin     Siswa[]            @relation("SiswaTahsin")
  siswaTahfidz    Siswa[]            @relation("SiswaTahfidz")
  setoranHafalan  Setoran_Hafalan[]
  setoranMurajaah Setoran_Murajaah[]
  setoranTahsin   Setoran_Tahsin[]
  ujianKenaikan   Ujian_Kenaikan[]

  @@map("halaqoh")
}

model Setoran_Hafalan {
  id                 String   @id @default(uuid())
  timestamp          DateTime @default(now())
  nis_siswa          String
  halaqohId          String?
  no_surah           Int
  ayat_awal          Int
  ayat_akhir         Int
  jumlah_pengulangan Int
  toggle_tarjamah    Boolean
  jumlah_salah       Int

  nilai_bacaan  Int
  nilai_hafalan Int

  rata_rata         Int
  predikat          Predikat
  status_kelanjutan STATUS_KELANJUTAN

  siswa   Siswa    @relation("LaporanHafalanBaru", fields: [nis_siswa], references: [nis], onDelete: Cascade)
  halaqoh Halaqoh? @relation(fields: [halaqohId], references: [id], onDelete: SetNull)
  surah   Surah    @relation(fields: [no_surah], references: [no_surah])

  @@index([nis_siswa])
  @@index([timestamp])
  @@index([halaqohId])
  @@map("setoran_hafalan")
}

model Setoran_Murajaah {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  nis_siswa    String
  halaqohId    String?
  no_surah     Int
  ayat_awal    Int
  ayat_akhir   Int
  jumlah_salah Int

  nilai_bacaan  Int
  nilai_hafalan Int

  rata_rata Int
  predikat  Predikat

  siswa   Siswa    @relation(fields: [nis_siswa], references: [nis], onDelete: Cascade)
  halaqoh Halaqoh? @relation(fields: [halaqohId], references: [id], onDelete: SetNull)
  surah   Surah    @relation(fields: [no_surah], references: [no_surah])

  @@index([nis_siswa])
  @@index([timestamp])
  @@index([halaqohId])
  @@map("setoran_murajaah")
}

model Setoran_Tahsin {
  id                 String   @id @default(uuid())
  timestamp          DateTime @default(now())
  nis_siswa          String
  id_kelompok        String?
  hafalan_surah      Int?
  hafalan_ayat_awal  Int?
  hafalan_ayat_akhir Int?

  tahapan Tahapan

  // bentuk A
  jilid Int?
  bab   Int? // bisa ke gharib keatas

  no_surah   Int?
  ayat_awal  Int?
  ayat_akhir Int?
  // gharib / tajwid

  materi String?

  nilai             String
  keterangan        String
  status_kelanjutan STATUS_KELANJUTAN

  // Penanda: true jika record ini dibuat otomatis saat pretest (bukan pertemuan nyata)
  is_placement Boolean @default(false)

  siswa        Siswa    @relation("LaporanTahsinBaru", fields: [nis_siswa], references: [nis], onDelete: Cascade)
  halaqoh      Halaqoh? @relation(fields: [id_kelompok], references: [id], onDelete: SetNull)
  hafalahSurah Surah?   @relation("HafalanSurah", fields: [hafalan_surah], references: [no_surah])
  surah        Surah?   @relation("LaporanBacaan", fields: [no_surah], references: [no_surah])

  @@index([nis_siswa])
  @@index([timestamp])
  @@index([id_kelompok])
  @@index([status_kelanjutan])
  @@map("setoran_tahsin")
}

// ujian kenaikan tingkat

model Ujian_Kenaikan {
  id          String @id @default(uuid())
  nis_siswa   String
  id_kelompok String?

  tahapan Tahapan

  nilai            String
  keterangan       String
  status_kelulusan STATUS_KELULUSAN

  siswa   Siswa   @relation(fields: [nis_siswa], references: [nis], onDelete: Cascade)
  halaqoh Halaqoh? @relation(fields: [id_kelompok], references: [id], onDelete: SetNull)

  @@map("ujian_kenaikan")
}

model Ujian_Pretest {
  id        String @id @default(uuid())
  nis_siswa String

  keterangan String?

  tahapan Tahapan

  jilid      Int?
  halaman    Int?
  no_surah   Int?
  ayat_awal  Int?
  ayat_akhir Int?
  materi     String?

  siswa Siswa  @relation(fields: [nis_siswa], references: [nis], onDelete: Cascade)
  surah Surah? @relation(fields: [no_surah], references: [no_surah])

  @@map("ujian_pretest")
}

model Pengajuan_Ujian {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  nis_siswa String
  id_guru   String
  kategori  Kategori
  tahapan   Tahapan

  siswa Siswa @relation(fields: [nis_siswa], references: [nis], onDelete: Cascade)
  guru  User  @relation(fields: [id_guru], references: [id], onDelete: Cascade)

  @@index([nis_siswa])
  @@index([id_guru])
  @@map("pengajuan_ujian")
}

// Session terpisah untuk mendukung login multi-device.
// 1 user/siswa → banyak session (1 per device/browser). Login menambah baris
// baru (tidak menimpa), logout menghapus 1 baris saja. Token disimpan di sini,
// BUKAN di kolom User/Siswa (model lama).
model Session {
  id         String    @id @default(uuid())
  token      String    @unique @db.Text
  user_id    String?
  nis_siswa  String?
  user       User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  siswa      Siswa?    @relation(fields: [nis_siswa], references: [nis], onDelete: Cascade)
  created_at DateTime  @default(now())
  // 12 jam, mengikuti session_expires_at di frontend (LoginPage/WaliLogin).
  expires_at DateTime?
  user_agent String?   @db.Text
  ip_address String?

  @@index([user_id])
  @@index([nis_siswa])
  @@map("session")
}
