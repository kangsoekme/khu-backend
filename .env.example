# ─────────────────────────────────────────────────────────────
# KHU Backend - Environment Variables (contoh)
# Salin file ini menjadi .env dan sesuaikan nilainya.
# Saat menjalankan via Docker, variabel ini diatur di docker-compose.yaml.
# ─────────────────────────────────────────────────────────────

# Koneksi database PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://admin:belajaralquran@localhost:5432/khu_belajar_quran?schema=public"

# Port aplikasi backend
PORT=5000

# SEC-4: URL frontend yang diizinkan oleh CORS (WAJIB di production).
# Dipisah koma jika lebih dari satu origin.
# Contoh production: FRONTEND_URL=https://khu.example.com
# Contoh multi-origin: FRONTEND_URL=https://khu.example.com,https://www.khu.example.com
FRONTEND_URL=
